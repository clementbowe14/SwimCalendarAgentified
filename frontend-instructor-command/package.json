{
  "name": "frontend-instructor-command",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCK_API=true VITE_INSTRUCTOR_API_URL= vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test:e2e": "npm run test:e2e:mock",
    "test:e2e:mock": "VITE_USE_MOCK_API=true VITE_INSTRUCTOR_API_URL= playwright test e2e/instructor-command.spec.ts",
    "test:e2e:auth": "VITE_USE_MOCK_API=false VITE_INSTRUCTOR_API_URL=/api playwright test e2e/auth-flow.spec.ts",
    "test:e2e:live": "VITE_USE_MOCK_API=false playwright test e2e/instructor-command.live.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
