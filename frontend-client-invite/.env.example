# HTTP mode is the default for local development and all production builds.
VITE_USE_MOCK_API=false
VITE_CLIENT_INVITE_API_URL=http://127.0.0.1:8000/api/public

# For deliberate local mock development, set VITE_USE_MOCK_API=true and
# remove or blank VITE_CLIENT_INVITE_API_URL. Production mock builds are rejected.
