{
  "name": "frontend-client-invite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3001",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3001",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test tests/real-backend-integration.spec.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-icons": "1.3.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^26.6.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "ical.js": "^2.2.1",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
